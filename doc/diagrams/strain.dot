digraph s {
  rankdir=LR; nodesep=0.3; ranksep=0.5;
  graph [fontname="Noto Sans", fontsize=10, bgcolor="transparent", pad=0.15];
  node  [fontname="Noto Sans", fontsize=10, shape=box, style="rounded,filled",
         fillcolor="#F2F7F8", color="#0C6B7A", penwidth=1.2, margin="0.16,0.09"];
  edge  [fontname="Noto Sans", fontsize=8.5, color="#5A6360", arrowsize=0.75,
         fontcolor="#4A5557"];

  ep  [label="entry panel\narrestors · bonded baseplate",
       fillcolor="#F2F7F8", color="#0C6B7A"];
  si  [label="anchored strain insulator\ntakes ALL mechanical load",
       fillcolor="#F7EBCC", color="#8A5D04"];
  jmp [label="short flexible jumper\nmaintains ~6\" spacing"];
  ft  [label="feedthroughs\n≥10 kV ceramic", fillcolor="#F6DED9", color="#A82E1E"];
  ep->si->jmp->ft;
  note [label="no tension reaches the ceramic", shape=plaintext,
        fillcolor="transparent", fontcolor="#A82E1E", fontsize=9];
  ft->note [style=dotted, color="#A82E1E", arrowhead=none];
}