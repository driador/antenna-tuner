digraph x {
  rankdir=LR; nodesep=0.25; ranksep=0.5;
  graph [fontname="Noto Sans", fontsize=10, bgcolor="transparent", pad=0.15];
  node  [fontname="Noto Sans", fontsize=10, shape=box, style="rounded,filled",
         fillcolor="#F2F7F8", color="#0C6B7A", penwidth=1.2, margin="0.16,0.09"];
  edge  [fontname="Noto Sans", fontsize=8.5, color="#5A6360", arrowsize=0.75,
         fontcolor="#4A5557"];

  subgraph cluster_s {
    label="SAMPLER CHAMBER"; fontname="Noto Sans"; fontsize=9;
    color="#4F5B93"; style=dashed; fontcolor="#4F5B93";
    cpl [label="coupler"]; pad [label="60 dB SMA pads"];
    det [label="Schottky detectors"]; ad  [label="AD8302"];
    cpl->pad; pad->det; pad->ad;
  }
  f1 [label="0.01 µF + 1 kΩ", shape=box, style="filled,dashed",
      fillcolor="#FAFBFB", color="#4A5557"];
  subgraph cluster_c {
    label="CONTROL CHAMBER"; fontname="Noto Sans"; fontsize=9;
    color="#0C6B7A"; style=dashed; fontcolor="#0C6B7A";
    adc [label="Teensy ADC\nV_FWD · V_REF · V_MAG · V_PHS",
         fillcolor="#DCEBDF", color="#2C6539"];
  }
  det->f1; ad->f1; f1->adc;
  nort [label="no RF crosses the bulkhead", shape=plaintext,
        fillcolor="transparent", fontcolor="#A82E1E", fontsize=9];
  f1->nort [style=dotted, color="#A82E1E", arrowhead=none];
}