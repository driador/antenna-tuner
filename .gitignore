# --- environments / caches
cad/.venv/
__pycache__/
*.pyc

# --- working backups (git history replaces them)
.*.pre-*
*.bak
!kicad/*.nucleo.bak

# --- doc build products (regenerated by doc/build.sh, doc/build_review.sh)
doc/doc.html
doc/rev.html
doc/sheets/

# --- CAD outputs regenerated wholesale on every run (timestamps change every time)
cad/out/*.step
cad/out/*.FCStd
cad/out/*.FCBak
cad/out/*.svg
cad/out/*.json
cad/out/*.log
cad/out/preview/

# --- NEC: raw decks and 420 MB of solver output; summaries (*.csv, *.txt) are tracked
nec/out/*.nec
nec/out/*.out
nec/nec2++

# --- KiCad local state
kicad/*.kicad_prl
kicad/fp-info-cache
kicad/*-backups/

# --- fab outputs, regenerated by kicad/fab.sh from the routed board
kicad/fab/
